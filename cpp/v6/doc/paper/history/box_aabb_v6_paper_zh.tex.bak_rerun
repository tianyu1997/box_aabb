\section{流水线复杂度汇总}\label{app:complexity}

\begin{table}[ht]
\centering
\small
\caption{SBF 主要阶段时间复杂度（$N$~盒数、$D$~关节数、
$L_\text{act}$~活动连杆、$\bar d$~平均 LECT 深度、$n_w$~线程数、
$M$~障碍数、$K$~平均命中砖数）。}
\label{tab:total_complexity}
\begin{tabular}{@{}lll@{}}
\toprule
\textbf{阶段} & \textbf{时间} & \textbf{备注} \\
\midrule
LECT 冷启动 (mmap)        & $\mathcal{O}(1)$           & lazy load \\
首次 IFK 分裂           & $\mathcal{O}(D L_\text{act})$ & + Z4 缓存命中降为 $\mathcal{O}(L_\text{act})$ \\
Hull16-Grid 光栅化       & $\mathcal{O}(K)$           & turbo 扫描线 \\
障碍--包络位 AND          & $\mathcal{O}(K)$           & 64-bit AND \\
单次 FFB                  & $\mathcal{O}(\bar d L_\text{act})$ & + 占用计数早退 \\
全部生长                  & $\mathcal{O}(N\bar d L_\text{act}/n_w)$ & 快照线程池 \\
粗化 (扫描+贪心)          & $\mathcal{O}(N\log N + N M)$ & Tarjan 关节点 \\
邻接增量维护              & $\mathcal{O}(N\log N)$ & 维度排序 \\
查询 (Dijkstra+优化)      & $\mathcal{O}(|E|\log|V|)$ & $|V|=N$ \\
LECT 增量保存             & $\mathcal{O}(\Delta N)$ & 追加+原子 rename \\
\bottomrule
\end{tabular}
\end{table}

